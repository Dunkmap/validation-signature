# Template. Copy to .env and fill in the real values:
#
#     cp .env.example .env
#
# .env is gitignored; this file is not. Never put a real key in here.

# --- mail -------------------------------------------------------------------
# console = print to the terminal, deliver NOTHING (local development)
# smtp    = a real send
ESIGN_MAIL=smtp

# Mailjet. USER and PASS are the API Key and Secret Key from
# Account Settings -> API Key Management (REST API) - NOT your Mailjet login.
ESIGN_SMTP_HOST=in-v3.mailjet.com
ESIGN_SMTP_PORT=587
ESIGN_SMTP_USER=your-mailjet-api-key
ESIGN_SMTP_PASS=your-mailjet-secret-key

# Must be a sender Mailjet has VERIFIED (Senders & Domains). A @gmail.com
# address is usually rejected or spam-filed by recipients even when verified,
# because Gmail's DMARC policy refuses mail sent as Gmail from elsewhere. Use
# an address on a domain you control.
ESIGN_MAIL_FROM=E-Sign <noreply@yourdomain.com>

# --- storage ----------------------------------------------------------------
# memory = wiped on restart, taking in-flight envelopes and verified sessions
# disk   = survives a restart
ESIGN_STORE=disk
ESIGN_DATA_DIR=./data

# --- API --------------------------------------------------------------------
# Shared secret for POST /envelopes. Change this; the default is public
# knowledge. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ESIGN_SECRET=local-dev-secret

ESIGN_FRONTEND_URL=http://127.0.0.1:3000
ESIGN_API_URL=http://127.0.0.1:4000

# Set true ONLY behind a proxy you control. Otherwise anyone can spoof
# X-Forwarded-For, defeat the rate limiter, and forge the IP on a signature.
ESIGN_TRUST_PROXY=false

# --- rate limits ------------------------------------------------------------
ESIGN_RATE_WINDOW_MS=60000
ESIGN_RATE_MAX=30
ESIGN_OTP_RATE_WINDOW_MS=900000
ESIGN_OTP_RATE_MAX=20
