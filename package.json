{
  "name": "esign",
  "version": "1.0.0",
  "description": "Standalone e-signature service: an API and the signer-facing page, run separately.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "start": "concurrently -n api,web -c cyan,green \"npm:start:api\" \"npm:start:web\"",
    "start:api": "npm start --workspace backend",
    "start:web": "npm start --workspace frontend",
    "test": "npm test --workspace backend",
    "seed": "npm run seed --workspace backend",
    "make-pdf": "npm run make-pdf --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
